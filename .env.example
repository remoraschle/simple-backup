# Kopie als .env anlegen und ausfuellen. Die .env selbst gehoert nicht ins Repository.

# Datenbank
POSTGRES_DB=simplebackup
POSTGRES_USER=simplebackup
POSTGRES_PASSWORD=hier-ein-langes-zufaelliges-passwort-eintragen

# Port, unter dem die Oberflaeche erreichbar ist
HTTP_PORT=8080

# Auf true setzen, sobald die Anwendung hinter TLS laeuft. Bei true sendet der Browser das
# Sitzungscookie nur ueber HTTPS -- ueber HTTP koennte man sich dann nicht mehr anmelden.
COOKIE_SECURE=false

TZ=Europe/Zurich

# Blockgeraete, die als Quelle gesichert werden duerfen -- einzeln, durch Komma getrennt.
# Leer heisst: keine, und dann bietet die Oberflaeche den Quelltyp gar nicht erst an.
# Das Geraet muss zusaetzlich in compose.yaml unter "devices:" durchgereicht werden.
DEVICES=

# Anmeldung ueber einen Anbieter (Authelia, Keycloak, Authentik).
# Alle vier Zeilen gehoeren zusammen; ohne das Profil bleibt es beim Anmeldeformular.
# SPRING_PROFILES=oidc
# OIDC_ISSUER=https://auth.example.org
# OIDC_CLIENT_ID=simple-backup
# OIDC_CLIENT_SECRET=
# Wer in dieser Gruppe ist, wird Administrator. Ohne Angabe bekommt jeder neue Zugang
# Leserechte -- eine Anmeldung soll niemanden versehentlich zum Administrator machen.
# OIDC_ADMIN_GROUP=backup-admins

# Der Masterkey steht NICHT hier, sondern in secrets/master_key:
#   mkdir -p secrets && openssl rand -base64 32 > secrets/master_key && chmod 600 secrets/master_key
#
# Diesen Schluessel zusaetzlich im Passwortmanager sichern. Geht er verloren, sind alle
# gespeicherten Zugangsdaten unwiederbringlich verloren.
