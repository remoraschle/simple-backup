# Kopie als .env anlegen und ausfuellen. Die .env selbst gehoert nicht ins Repository.

# Datenbank
POSTGRES_DB=simplebackup
POSTGRES_USER=simplebackup
POSTGRES_PASSWORD=hier-ein-langes-zufaelliges-passwort-eintragen

# Port, unter dem die Oberflaeche erreichbar ist
HTTP_PORT=8080

# Auf true setzen, sobald die Anwendung hinter TLS laeuft. Bei true sendet der Browser das
# Sitzungscookie nur ueber HTTPS -- ueber HTTP koennte man sich dann nicht mehr anmelden.
COOKIE_SECURE=false

TZ=Europe/Zurich

# Der Masterkey steht NICHT hier, sondern in secrets/master_key:
#   mkdir -p secrets && openssl rand -base64 32 > secrets/master_key && chmod 600 secrets/master_key
#
# Diesen Schluessel zusaetzlich im Passwortmanager sichern. Geht er verloren, sind alle
# gespeicherten Zugangsdaten unwiederbringlich verloren.
